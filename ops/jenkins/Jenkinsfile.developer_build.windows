pipeline {
  agent any

  parameters {
    string(name: 'NAMESPACE_SUFFIX', defaultValue: 'dev01', description: 'Namespace suffix. Final namespace = yas-<suffix>. Example: dev-tax')
    string(name: 'DOCKERHUB_USER', defaultValue: 'CHANGE_ME', description: 'Docker Hub username/namespace that stores yas-* images')
    string(name: 'DOMAIN', defaultValue: 'yas.local', description: 'Local domain used with Windows hosts file')

    string(name: 'PRODUCT_BRANCH', defaultValue: 'main', description: 'Branch for product service')
    string(name: 'CART_BRANCH', defaultValue: 'main', description: 'Branch for cart service')
    string(name: 'ORDER_BRANCH', defaultValue: 'main', description: 'Branch for order service')
    string(name: 'CUSTOMER_BRANCH', defaultValue: 'main', description: 'Branch for customer service')
    string(name: 'INVENTORY_BRANCH', defaultValue: 'main', description: 'Branch for inventory service')
    string(name: 'TAX_BRANCH', defaultValue: 'main', description: 'Branch for tax service')
    string(name: 'MEDIA_BRANCH', defaultValue: 'main', description: 'Branch for media service')
    string(name: 'SEARCH_BRANCH', defaultValue: 'main', description: 'Branch for search service')
    string(name: 'STOREFRONT_BFF_BRANCH', defaultValue: 'main', description: 'Branch for storefront-bff service')
    string(name: 'STOREFRONT_UI_BRANCH', defaultValue: 'main', description: 'Branch for storefront UI source folder storefront')
    string(name: 'BACKOFFICE_BFF_BRANCH', defaultValue: 'main', description: 'Branch for backoffice-bff service')
    string(name: 'BACKOFFICE_UI_BRANCH', defaultValue: 'main', description: 'Branch for backoffice UI source folder backoffice')

    booleanParam(name: 'ENABLE_ISTIO_INJECTION', defaultValue: false, description: 'Enable only when running service mesh demo')
  }

  environment {
    BASE_NAMESPACE = "yas-${params.NAMESPACE_SUFFIX}"
    KUBECONFIG = 'C:\\ProgramData\\Jenkins\\.kube\\config'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        powershell '''
        git remote -v
        git branch -a
        '''
      }
    }

    stage('Check Windows tools') {
      steps {
        powershell '''
        $ErrorActionPreference = "Stop"
        git --version
        kubectl version --client
        helm version
        kubectl config use-context docker-desktop
        kubectl get nodes
        '''
      }
    }

    stage('Resolve branch tags') {
      steps {
        script {
          def mapping = [
            'PRODUCT': params.PRODUCT_BRANCH,
            'CART': params.CART_BRANCH,
            'ORDER': params.ORDER_BRANCH,
            'CUSTOMER': params.CUSTOMER_BRANCH,
            'INVENTORY': params.INVENTORY_BRANCH,
            'TAX': params.TAX_BRANCH,
            'MEDIA': params.MEDIA_BRANCH,
            'SEARCH': params.SEARCH_BRANCH,
            'STOREFRONT_BFF': params.STOREFRONT_BFF_BRANCH,
            'STOREFRONT_UI': params.STOREFRONT_UI_BRANCH,
            'BACKOFFICE_BFF': params.BACKOFFICE_BFF_BRANCH,
            'BACKOFFICE_UI': params.BACKOFFICE_UI_BRANCH
          ]

          def lines = []
          lines.add("DOCKERHUB_USER=${params.DOCKERHUB_USER}")
          lines.add("NAMESPACE=${env.BASE_NAMESPACE}")
          lines.add("DOMAIN=${params.DOMAIN}")
          lines.add("ENABLE_ISTIO_INJECTION=${params.ENABLE_ISTIO_INJECTION}")

          mapping.each { key, branchValue ->
            def branch = branchValue.trim()
            if (branch == 'main') {
              lines.add("TAG_${key}=main")
            } else {
              def psScript = """
              \$line = git ls-remote origin refs/heads/${branch}
              if ([string]::IsNullOrWhiteSpace(\$line)) { exit 0 }
              \$sha = (\$line -split '\\s+')[0]
              \$sha.Substring(0, 7)
              """
              def sha = powershell(returnStdout: true, script: psScript).trim()
              if (sha == '') {
                error("Branch '${branch}' was not found on origin. Check ${key}_BRANCH parameter.")
              }
              lines.add("TAG_${key}=${sha}")
            }
          }

          writeFile file: '.deploy.env', text: lines.join('\n') + '\n'
          powershell '''
          Get-Content .deploy.env | ForEach-Object {
            if ($_ -match "DOCKERHUB_USER=") { "DOCKERHUB_USER=***masked***" } else { $_ }
          }
          '''
        }
      }
    }

    stage('Deploy full YAS core set') {
      steps {
        powershell '''
        $ErrorActionPreference = "Stop"
        powershell -ExecutionPolicy Bypass -File .\ops\windows\deploy-yas-core.ps1
        '''
      }
    }

    stage('Collect evidence') {
      steps {
        powershell '''
        powershell -ExecutionPolicy Bypass -File .\ops\windows\collect-evidence.ps1 -Namespace $env:BASE_NAMESPACE
        '''
      }
    }

    stage('Print access links') {
      steps {
        powershell '''
        powershell -ExecutionPolicy Bypass -File .\ops\windows\Get-AccessUrls.ps1 -Namespace $env:BASE_NAMESPACE -Domain "${env:DOMAIN}"
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: '.deploy.env,evidence/**/*', allowEmptyArchive: true
    }
  }
}
